{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "caebb15",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: divit ${version} yayını",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "divit",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Yeni" },
        { "type": "fix", "section": "Düzeltme" },
        { "type": "perf", "section": "Hız" },
        { "type": "docs", "section": "Belgeler" },
        { "type": "chore", "section": "Diğer", "hidden": true }
      ]
    }
  }
}
