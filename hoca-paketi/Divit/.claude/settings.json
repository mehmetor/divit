{
  "extraKnownMarketplaces": {
    "divit": {
      "source": {
        "source": "url",
        "url": "https://raw.githubusercontent.com/mehmetor/divit/main/.claude-plugin/marketplace.json"
      },
      "autoUpdate": true
    }
  },
  "env": {
    "DIVIT_PANDOC": "__PANDOC__"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Read(~/.claude/plugins/**)",
      "Edit(./tez-kontrol/rapor/**)",
      "Edit(./yazilar/**)",
      "Edit(./cikti/**)",
      "Edit(./kaynaklar/dogrulama.md)",
      "Edit(./.divit/**)",
      "Bash(*pandoc*)",
      "PowerShell(*pandoc*)",
      "Bash(open *)",
      "PowerShell(Invoke-Item *)",
      "PowerShell(Start-Process *)",
      "Bash(curl -fsSL -o *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(New-Item *)",
      "Bash(mkdir *)",
      "WebSearch",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.unpaywall.org)",
      "WebFetch(domain:dergipark.org.tr)",
      "WebFetch(domain:akademik.yok.gov.tr)"
    ],
    "deny": [
      "Edit(./**/gelen/**)",
      "Read(./hakemlik/**)",
      "Edit(./hakemlik/**)",
      "Bash(rm *)",
      "PowerShell(Remove-Item *)",
      "Bash(git reset *)"
    ]
  }
}
