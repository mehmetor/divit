{
  "extraKnownMarketplaces": {
    "divit": {
      "source": {
        "source": "url",
        "url": "https://raw.githubusercontent.com/mehmetor/divit/main/.claude-plugin/marketplace.json"
      },
      "autoUpdate": true
    }
  },
  "model": "claude-opus-5-5",
  "effortLevel": "low",
  "env": {
    "DIVIT_PANDOC": "__PANDOC__",
    "DIVIT_PDFCPU": "__PDFCPU__",
    "DIVIT_PDFTOTEXT": "__PDFTOTEXT__"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Read(~/.claude/plugins/**)",
      "Read(~/.claude/projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "Edit(./tez-kontrol/rapor/**)",
      "Edit(./yazilar/**)",
      "Edit(./kitaplar/**)",
      "Edit(./cikti/**)",
      "Edit(./kaynaklar/dogrulama.md)",
      "Edit(./.divit/**)",
      "Bash(*pandoc*)",
      "PowerShell(*pandoc*)",
      "Bash(*pdfcpu*)",
      "PowerShell(*pdfcpu*)",
      "PowerShell(*pdftotext*)",
      "Bash(osascript -l JavaScript *)",
      "Bash(open *)",
      "PowerShell(Invoke-Item *)",
      "PowerShell(Start-Process *)",
      "Bash(curl -fsSL -o *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(New-Item *)",
      "Bash(mkdir *)",
      "Bash(sh */scripts/kitap-klasoru.sh *)",
      "PowerShell(*kitap-klasoru.ps1*)",
      "WebSearch",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.unpaywall.org)",
      "WebFetch(domain:dergipark.org.tr)",
      "WebFetch(domain:akademik.yok.gov.tr)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Edit(./**/gelen/**)",
      "Edit(./kitaplar/*/asil/**)",
      "Edit(./kitaplar/*/malzeme/**)",
      "Read(./hakemlik/**)",
      "Edit(./hakemlik/**)",
      "Bash(rm *)",
      "PowerShell(Remove-Item *)",
      "Bash(git reset *)"
    ]
  }
}
